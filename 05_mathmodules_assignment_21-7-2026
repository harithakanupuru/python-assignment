        "- Use **kwargs to collect keyword arguments.\n",
        "- args is a tuple.\n",
        "- kwargs is a dictionary.\n",
        "- Use len() to count values.\n",
        "def display_arguments(__________, __________): positional_count = __________ keyword_count = __________\n",
        "\n",
        "print(\"Positional count:\" positional_count) print(\"Keyword count:\", keyword_count) print(\"Positional values:\", __________) print(\"Keyword values:\", __________) display_arguments( 10, 20, 30, name=\"Rahul\", city=\"Bangalore\" )\n",
